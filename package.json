{
  "name": "herdr-prompt-bucket",
  "version": "0.1.0",
  "description": "A durable, event-driven prompt queue for coding agents running in Herdr.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/main.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^6.3.1",
    "ink-text-input": "^6.0.0",
    "minimatch": "^10.0.3",
    "proper-lockfile": "^4.1.2",
    "react": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
